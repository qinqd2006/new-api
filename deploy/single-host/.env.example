# Do not use this placeholder file directly. Run deploy.sh init to generate .env.
# Values are plain key=value, without quotes, export, or inline comments.
ADMIN_DOMAIN=admin.example.com
PORTAL_DOMAIN=console.example.com
API_DOMAIN=api.example.com
# Exact private IPv4 address assigned to this CVM, reachable by CLB.
BACKEND_IP=10.0.1.10
# Keep none when CLB preserves the client source IP. For SNAT/connection reuse,
# set verified proxy peer IPs/CIDRs, comma-separated; never trust all addresses.
TRUSTED_PROXY_CIDRS=none
# Space-separated source IPs/CIDRs; use the public egress IP of your office/VPN.
ADMIN_ALLOW_CIDRS=203.0.113.10/32
# PG/Redis bind loopback; application ports bind BACKEND_IP.
PG_PORT=15432
REDIS_PORT=16379
MANAGEMENT_PORT=3000
PORTAL_PORT=3001
# Generated independently by init; never paste production values into Git.
POSTGRES_PASSWORD=GENERATED_BY_INIT
APP_DB_PASSWORD=GENERATED_BY_INIT
REDIS_PASSWORD=GENERATED_BY_INIT
MANAGEMENT_SESSION_SECRET=GENERATED_BY_INIT
PORTAL_SESSION_SECRET=GENERATED_BY_INIT
CRYPTO_SECRET=GENERATED_BY_INIT
