[Unit]
Description=new-api %i service
Wants=network-online.target
After=network-online.target new-api-infra.service
Requires=new-api-infra.service
StartLimitIntervalSec=0
ConditionPathExists=/opt/new-api-runtime/current/new-api

[Service]
Type=simple
User=new-api-%i
Group=new-api-%i
StateDirectory=new-api-%i
StateDirectoryMode=0700
WorkingDirectory=/var/lib/new-api-%i
Environment=HOME=/var/lib/new-api-%i
EnvironmentFile=/etc/new-api/%i.env
ExecStart=/opt/new-api-runtime/current/new-api
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
